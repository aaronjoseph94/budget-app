# The two public values. Both appear in every request the browser makes and are
# meant to be seen; the row-level security policies in supabase/migrations are
# what actually protect the data.
#
# Supabase -> Project Settings -> API. Copy "Project URL" and "anon public".
#
# The service_role key does NOT belong here, or in any VITE_ variable, or
# anywhere else reachable from the browser: it bypasses every access rule.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
