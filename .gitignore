# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.expo/
web-build/
*.tsbuildinfo

# Environment and secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# Financial source data — never commit (CLAUDE.md)
*.xlsx
*.xls
*.csv
# Statements come as PDFs and exports; receipts are phone photos. App icons
# are PNG, so *.png stays tracked.
*.pdf
*.ofx
*.qfx
*.qif
*.numbers
*.ods
*.heic
*.heif
*.jpg
*.jpeg
*.webp
# Patterns here match case, and iPhones name files IMG_0001.HEIC.
*.PDF
*.HEIC
*.HEIF
*.JPG
*.JPEG
receipts/
statements/
!packages/*/test/fixtures/**/*.csv

# Supabase local
supabase/.temp/
supabase/.branches/

# Test output
coverage/
.vitest/

# OS / editor
.DS_Store
.idea/
*.swp

# App build output
apps/*/dist/
apps/*/dist-types/
